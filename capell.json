{
    "manifest-version": 3,
    "name": "capell-app/content-sections",
    "slug": "content-sections",
    "displayName": "Content Sections",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Build reusable page sections such as FAQs, pricing tables and team grids once, then use them on many pages.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\ContentSections",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/block-library",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder",
            "capell-app/theme-foundation"
        ],
        "supports": [
            "capell-app/publishing-studio",
            "capell-app/public-actions"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\ContentSections\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": [],
        "runtime": [
            "Capell\\ContentSections\\Providers\\ContentSectionsServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "resourceClass": "Capell\\ContentSections\\Filament\\Resources\\Sections\\SectionResource",
            "group": "Section"
        },
        {
            "type": "configurator",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "configuratorEnum": "Capell\\ContentSections\\Enums\\SectionConfiguratorEnum",
            "groups": ["Sections"]
        },
        {
            "type": "asset",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "asset": "section",
            "modelClass": "Capell\\ContentSections\\Models\\Section"
        },
        {
            "type": "page-type",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "pageType": "section",
            "modelClass": "Capell\\ContentSections\\Models\\Section"
        },
        {
            "type": "model",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "modelClass": "Capell\\ContentSections\\Models\\Section"
        },
        {
            "type": "frontend-component",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "keys": ["section.widget", "section.team-member"]
        },
        {
            "type": "schema-extender",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsSchemaExtendersContribution",
            "tag": "capell-content-sections:section-schema-extenders",
            "extends": "section configurator meta schemas"
        },
        {
            "type": "route",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsRoutesContribution",
            "routes": [
                "capell-content-sections.screenshot-fixtures.section-selector-modal",
                "capell-content-sections.screenshot-fixtures.section-widget-gallery"
            ],
            "prefix": "screenshot-fixtures/content-sections",
            "middleware": ["web"]
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsScheduledVisibilityContribution",
            "command": "content-sections:invalidate-due-caches",
            "frequency": "everyMinute"
        },
        {
            "type": "console-command",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsConsoleCommandsContribution",
            "commands": ["content-sections:invalidate-due-caches"],
            "commandClasses": [
                "Capell\\ContentSections\\Console\\Commands\\InvalidateDueScheduledSectionCachesCommand"
            ]
        },
        {
            "type": "route",
            "class": "Capell\\ContentSections\\Manifest\\PublicSectionFragmentsRoutesContribution",
            "routes": ["capell-content-sections.fragments.show"],
            "prefix": "_capell/content-sections/fragments",
            "middleware": ["throttle:capell-content-sections-fragment"]
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["sections"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "invalidateDueCaches": "content-sections:invalidate-due-caches"
    },
    "actions": {
        "install": "Capell\\ContentSections\\Actions\\InstallContentSectionsPackageAction"
    },
    "settings": [],
    "permissions": [
        "ViewAny:Section",
        "View:Section",
        "Create:Section",
        "Update:Section",
        "Delete:Section",
        "DeleteAny:Section",
        "Restore:Section",
        "RestoreAny:Section",
        "ForceDelete:Section",
        "ForceDeleteAny:Section",
        "Replicate:Section",
        "Reorder:Section"
    ],
    "capabilities": [
        "content-sections",
        "content-sections-admin",
        "content-sections-block-library-bridge",
        "content-sections-layout-builder-payloads",
        "content-sections-publishing-studio-bridge",
        "content-sections-public-actions-bridge",
        "requires-livewire"
    ],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [
                "GET /_capell/content-sections/fragments/{reference} (capell-content-sections.fragments.show)",
                "GET /screenshot-fixtures/content-sections/section-selector-modal (capell-content-sections.screenshot-fixtures.section-selector-modal)",
                "GET /screenshot-fixtures/content-sections/section-widget-gallery (capell-content-sections.screenshot-fixtures.section-widget-gallery)"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "GET /_capell/content-sections/fragments/{reference} (capell-content-sections.fragments.show)",
                "GET /screenshot-fixtures/content-sections/section-selector-modal (capell-content-sections.screenshot-fixtures.section-selector-modal)",
                "GET /screenshot-fixtures/content-sections/section-widget-gallery (capell-content-sections.screenshot-fixtures.section-widget-gallery)"
            ]
        },
        "throttles": {
            "capell-content-sections-fragment": {
                "maxAttempts": 120,
                "decaySeconds": 60,
                "routes": [
                    "GET /_capell/content-sections/fragments/{reference} (capell-content-sections.fragments.show)",
                    "GET /screenshot-fixtures/content-sections/section-selector-modal (capell-content-sections.screenshot-fixtures.section-selector-modal)",
                    "GET /screenshot-fixtures/content-sections/section-widget-gallery (capell-content-sections.screenshot-fixtures.section-widget-gallery)"
                ]
            }
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "ViewAny:Section",
                "View:Section",
                "Create:Section",
                "Update:Section",
                "Delete:Section",
                "DeleteAny:Section",
                "Restore:Section",
                "RestoreAny:Section",
                "ForceDelete:Section",
                "ForceDeleteAny:Section",
                "Replicate:Section",
                "Reorder:Section"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["content-sections"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\ContentSections\\Models\\Section",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "content-sections.package-health",
            "label": "Content Sections package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ContentSections\\Health\\ContentSectionsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Seventeen ready-made section types you edit once and reuse across your pages, with usage counts and start and end dates.",
        "description": "A FAQ, a logo strip or a pricing table often appears on many pages. Here you make it once as a section and drop it in wherever it belongs, and an edit shows on every page at once. You choose from 17 ready-made types, including team grids and testimonials, add your words and pictures, and the result matches your site's design. Pricing buttons link to other pages, and no payment is taken in a section. The admin says how many places use a section before you change or remove it, and a deleted one can be brought back. Dates let a seasonal banner turn up and disappear on its own.",
        "problem": "We raised a price and now I have to find every page that carries a copy of the pricing table.",
        "outcome": "You change a section once and every page that uses it shows the new content.",
        "faq": [
            {
                "question": "What happens on my pages when I change a shared section?",
                "answer": "Every page that uses the section shows the change. Before you change or delete one, the admin tells you how many places use it, in words like Used in 3 places."
            },
            {
                "question": "Can I bring back a section I deleted by mistake?",
                "answer": "Yes. Deleting hides the section, and any child sections deleted with it, from your pages. Restore it from the deleted records filter and it shows again where it was placed, because pages keep their link to it."
            },
            {
                "question": "Can I go back to an earlier version of a section?",
                "answer": "Yes. Each save is kept as a revision, and restoring one puts back the name, settings, dates and text on every page that uses the section. Pictures and attached assets are not part of a revision."
            },
            {
                "question": "Do I need anything else to place sections on pages?",
                "answer": "Yes. Sections are placed on pages in Layout Builder, the page builder, which has to be installed as well."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Content Sections card with a Sections list and a Create Section form above steps labelled Choose, Configure and Reuse.",
                "caption": "The card pairs the list of reusable sections with the form for making a new one."
            },
            {
                "path": "docs/screenshots/sections-index.png",
                "alt": "Sections list with six published sections, their type, a Used in column and how many sections each one contains.",
                "caption": "See which sections are already on pages before you change or delete one."
            },
            {
                "path": "docs/screenshots/sections-create.png",
                "alt": "Create Section form with a name, a Content section type, a title, a text editor and a Publish from date.",
                "caption": "Pick a type, add the words and, if you like, set the date the section becomes available."
            },
            {
                "path": "docs/screenshots/sections-edit-with-assets.png",
                "alt": "Edit form for a workshop introduction section with a title, text, a Save and Publish button and an Assets panel below.",
                "caption": "An existing section is edited the same way, with a panel below listing what belongs to it."
            }
        ],
        "categories": ["admin", "foundation", "frontend"]
    },
    "contributionTraceability": {
        "deferredContributions": [],
        "contributions": [
            {
                "type": "blueprint-subject",
                "key": "section",
                "providerBucket": "runtime"
            },
            {
                "type": "page-type",
                "key": "section",
                "providerBucket": "runtime"
            }
        ]
    }
}
