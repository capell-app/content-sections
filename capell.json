{
    "manifest-version": 3,
    "name": "capell-app/content-sections",
    "slug": "content-sections",
    "displayName": "Content Sections",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Seventeen ready-to-use, themeable page sections — hero, FAQ, pricing, stats, testimonials, team, comparison, timeline and more — that editors reuse across pages and developers render through safe, package-owned Blade. Bundled free with Capell Foundation.",
    "product": {
        "group": "Capell Foundation",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\ContentSections",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/block-library",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": [
            "capell-app/publishing-studio",
            "capell-app/public-actions"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\ContentSections\\Providers\\ContentSectionsServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "resourceClass": "Capell\\ContentSections\\Filament\\Resources\\Sections\\SectionResource",
            "group": "Section"
        },
        {
            "type": "configurator",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "configuratorEnum": "Capell\\ContentSections\\Enums\\SectionConfiguratorEnum",
            "groups": ["Sections"]
        },
        {
            "type": "asset",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "asset": "section",
            "modelClass": "Capell\\ContentSections\\Models\\Section"
        },
        {
            "type": "page-type",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "pageType": "section",
            "modelClass": "Capell\\ContentSections\\Models\\Section"
        },
        {
            "type": "model",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "modelClass": "Capell\\ContentSections\\Models\\Section"
        },
        {
            "type": "frontend-component",
            "class": "Capell\\ContentSections\\Manifest\\ContentSectionsPackageContribution",
            "keys": ["section.widget", "section.team-member"]
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["sections"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [
        "ViewAny:Section",
        "View:Section",
        "Create:Section",
        "Update:Section",
        "Delete:Section",
        "DeleteAny:Section",
        "Restore:Section",
        "RestoreAny:Section",
        "ForceDelete:Section",
        "ForceDeleteAny:Section",
        "Replicate:Section",
        "Reorder:Section"
    ],
    "capabilities": [
        "content-sections",
        "content-sections-admin",
        "content-sections-public-rendering",
        "content-sections-section-registry",
        "content-sections-block-library-bridge",
        "content-sections-layout-builder-payloads",
        "content-sections-public-output-sanitisation",
        "content-sections-publishing-studio-bridge",
        "content-sections-public-actions-bridge"
    ],
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["content-sections"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\ContentSections\\Models\\Section",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "content-sections.package-health",
            "label": "Content Sections package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\ContentSections\\Health\\ContentSectionsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Seventeen ready-to-use, themeable page sections — hero, FAQ, pricing, stats, testimonials, team, comparison, timeline and more — that editors reuse across pages and developers render through safe, package-owned Blade. Bundled free with Capell Foundation.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Content Sections extension preview image",
                "caption": "Content Sections extension preview"
            }
        ],
        "categories": ["admin", "foundation", "frontend"]
    },
    "contributionTraceability": {
        "deferredContributions": [
            "admin-resource",
            "asset",
            "configurator",
            "model",
            "page-type",
            "route",
            "schema-extender"
        ]
    }
}
